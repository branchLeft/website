{
  "extends": ["@branchleft/tsconfig/strict-1.json", "@branchleft/tsconfig/react-app.json"],
  "include": ["**/*", "**/.server/**/*", "**/.client/**/*", ".react-router/types/**/*"],
  "exclude": ["infra"],
  "compilerOptions": {
    "types": ["node", "vite/client"],
    // React Router writes generated route types here and expects them resolved
    // as if they sat at the project root.
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "~/*": ["./app/*"]
    }
  }
}
