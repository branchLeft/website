# Copy to .env for local development. Never commit the real .env file.
#
# Used by app/lib/sendContactEmail.server.ts to send the /contact form to
# info@branchleft.co.uk over SMTP AUTH submission (port 587, STARTTLS).
#
# CONTACT_SMTP_USER/CONTACT_SMTP_PASSWORD are a dedicated submission-only
# credential, not the info@ mailbox's own password — it is restricted
# server-side to send-as only, so a leaked value here can't be used to read
# mail.
#
# In production these are set as real environment variables / secrets on the
# hosting platform, not loaded from this file.
CONTACT_SMTP_HOST=
CONTACT_SMTP_PORT=587
CONTACT_SMTP_USER=
CONTACT_SMTP_PASSWORD=
