# Copy to .env for local development. Never commit the real .env file.
#
# Used by app/lib/sendContactEmail.server.ts to send the /contact form to
# info@branchleft.co.uk over Gmail SMTP.
#
# GMAIL_USER must be the sending mailbox (info@branchleft.co.uk).
# GMAIL_APP_PASSWORD is a Google App Password for that mailbox (requires
# 2-Step Verification): https://myaccount.google.com/apppasswords
#
# In production these are set as real environment variables / secrets on the
# hosting platform, not loaded from this file.
GMAIL_USER=info@branchleft.co.uk
GMAIL_APP_PASSWORD=
