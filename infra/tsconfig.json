{
  "extends": ["@branchleft/tsconfig/strict-1.json", "@branchleft/tsconfig/pulumi.json"],
  "compilerOptions": {
    "pretty": true
  },
  // Recursive rather than a flat `*.ts` glob, which matches root-level files
  // only and drops a subdirectory's sources with no error.
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "bin"]
}
