{
  "name": "branchleft-website",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "prettier": "@branchleft/prettier-config",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test:unit": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "lint": "eslint app --ext .ts,.tsx --fix",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path node_modules/@branchleft/prettier-config/prettierignore",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path node_modules/@branchleft/prettier-config/prettierignore",
    "prepare": "[ \"$CI\" = \"true\" ] || pre-commit install"
  },
  "dependencies": {
    "@branchleft/components": "0.2.2",
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "framer-motion": "^13.2.0",
    "isbot": "^5.2.2",
    "lucide-react": "^1.46.0",
    "nodemailer": "^10.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@branchleft/prettier-config": "^0.3.1",
    "@branchleft/tsconfig": "^0.3.1",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.3",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "eslint": "^9.7.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
