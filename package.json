{
  "name": "branchleft-website",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.11",
  "prettier": "@branchleft/prettier-config",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test:unit": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path node_modules/@branchleft/prettier-config/prettierignore",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path node_modules/@branchleft/prettier-config/prettierignore",
    "prepare": "[ \"$CI\" = \"true\" ] || pre-commit install"
  },
  "dependencies": {
    "@branchleft/brand-branchleft": "0.3.0",
    "@branchleft/components": "0.6.0",
    "@react-router/node": "^8.5.1",
    "@react-router/serve": "^8.5.1",
    "framer-motion": "^13.4.6",
    "isbot": "^5.2.2",
    "lucide-react": "^1.70.0",
    "nodemailer": "^10.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@branchleft/prettier-config": "^0.8.8",
    "@branchleft/tsconfig": "^0.8.8",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.65.0",
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "eslint": "^9.7.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.3",
    "vitest": "^4.1.11"
  }
}
